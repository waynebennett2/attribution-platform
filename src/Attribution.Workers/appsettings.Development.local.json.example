{
  "_comment": "Copy this file to appsettings.Development.local.json (gitignored) and fill in your real values. That file is loaded last, so it overrides whatever is in appsettings.Development.json.",
  "ConnectionStrings": {
    "AttributionDb": "Server=<your-host>;Port=3306;Database=<your-database>;User=<your-user>;Password=<your-password>;"
  }
}
