# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up` — see docker-compose.yml's api1/worker1 services for how these are
# consumed. Both must be at least 32 characters (validated at container startup).
JWT_SIGNING_SECRET=replace-with-a-real-random-secret-at-least-32-characters
RETENTION_HMAC_KEY=replace-with-a-different-real-random-secret-at-least-32-chars
