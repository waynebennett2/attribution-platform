# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up` — see docker-compose.yml for how these are consumed. .env itself is
# never committed; this .example file is the only version tracked in git.

# --- Database (only used if you run MySQL via this compose file — see docker-compose.yml's
# comment on the mysql service for the managed-database alternative) ---
MYSQL_ROOT_PASSWORD=replace-with-a-real-random-password
MYSQL_PASSWORD=replace-with-a-different-real-random-password

# --- Api secrets — both must be at least 32 characters (validated at container startup) ---
JWT_SIGNING_SECRET=replace-with-a-real-random-secret-at-least-32-characters
RETENTION_HMAC_KEY=replace-with-a-different-real-random-secret-at-least-32-chars

# --- The attribution-ui's public origin, exactly as the browser sends it in its Origin
# header (scheme + host + port, no trailing slash) — e.g. https://admin.example.com.
# Without this, the CORS policy rejects every request the UI makes before RBAC even runs.
ADMIN_UI_ORIGIN=https://admin.example.com
